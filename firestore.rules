rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Orders collection:
    // - Anyone can create an order (valid order placement from client)
    // - Individual order can be retrieved by id (tracking)
    // - Listing all orders, modifying, or deleting requires authentication
    match /pedidos/{orderId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if request.resource.data.id == orderId;
      allow update, delete: if isAuthenticated();
    }

    // Products collection:
    // - Public menu read
    // - Only authenticated admin can modify products
    match /produtos/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Categories collection:
    match /categorias/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Coupons collection:
    match /cupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Store Settings:
    // - Public read for hours, address, delivery fees
    // - Admin only for updating settings
    match /configuracoes/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // System health check
    match /_system_health/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

